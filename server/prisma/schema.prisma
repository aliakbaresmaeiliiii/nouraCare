generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model address {
  id          Int      @id @default(autoincrement())
  userId      Int
  cityId      Int
  districtId  Int?
  addressLine String
  createdAt   DateTime @default(now())

  @@index([cityId], map: "address_cityId_fkey")
  @@index([districtId], map: "address_districtId_fkey")
  @@index([userId], map: "address_userId_fkey")
}

model chat_members {
  id       String            @id
  chatId   String
  userId   Int
  role     chat_members_role @default(MEMBER)
  joinedAt DateTime          @default(now())
  leftAt   DateTime?

  @@unique([chatId, userId])
  @@index([userId], map: "chat_members_userId_fkey")
}

model chat_messages {
  id          String                    @id
  content     String?                   @db.Text
  chatId      String
  senderId    Int
  messageType chat_messages_messageType @default(TEXT)
  mediaUrl    String?
  replyToId   String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime
  isDeleted   Boolean                   @default(false)

  @@index([chatId], map: "chat_messages_chatId_fkey")
  @@index([replyToId], map: "chat_messages_replyToId_fkey")
  @@index([senderId], map: "chat_messages_senderId_fkey")
}

model city {
  id    Int     @id @default(autoincrement())
  name  String
  state String?
}

model district {
  id     Int    @id @default(autoincrement())
  name   String
  cityId Int

  @@index([cityId], map: "district_cityId_fkey")
}

model doctors {
  id               String                   @id
  fullName         String
  specialty        String
  experienceYears  Int
  about            String                   @db.Text
  rating           Float                    @default(0)
  profileImageUrl  String?
  clinicName       String?
  location         String?
  contactEmail     String?
  contactPhone     String?
  consultationType doctors_consultationType
  fee              Float?
  availableSlots   Json?
  licenseNumber    String?
  licenseDocument  String?
  isVerified       Boolean
  verifiedAt       DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime
}

model forum_categories {
  id          String   @id
  name        String
  description String   @db.Text
  slug        String   @unique
  color       String?
  icon        String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model forum_comments {
  id        String   @id
  comment   String   @db.Text
  postId    String
  authorId  Int
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime
  isDeleted Boolean  @default(false)
  likeCount Int      @default(0)

  @@index([authorId], map: "forum_comments_authorId_fkey")
  @@index([parentId], map: "forum_comments_parentId_fkey")
  @@index([postId], map: "forum_comments_postId_fkey")
}

model forum_comment_likes {
  id        String   @id
  commentId String
  userId    Int
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model forum_posts {
  id        String   @id
  content   String   @db.Text
  threadId  String
  authorId  Int
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime
  isDeleted Boolean  @default(false)

  @@index([authorId], map: "forum_posts_authorId_fkey")
  @@index([parentId], map: "forum_posts_parentId_fkey")
  @@index([threadId], map: "forum_posts_threadId_fkey")
}

model forum_threads {
  id        String   @id
  title     String
  content   String   @db.Text
  forumId   String
  authorId  Int
  isPinned  Boolean  @default(false)
  isLocked  Boolean  @default(false)
  viewCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime
  likeCount Int      @default(0)

  @@index([authorId], map: "forum_threads_authorId_fkey")
  @@index([forumId], map: "forum_threads_forumId_fkey")
}

model forums {
  id          String   @id
  title       String
  description String   @db.Text
  categoryId  String
  createdById Int
  isPublic    Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([categoryId], map: "forums_categoryId_fkey")
  @@index([createdById], map: "forums_createdById_fkey")
}

model message_reads {
  id        String   @id
  messageId String
  userId    Int
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId], map: "message_reads_userId_fkey")
}

model onboarding_data {
  id                   Int       @id @default(autoincrement())
  userId               Int       @unique
  sessionId            String?
  pregnancyStatus      String?
  lastPeriodDate       DateTime?
  cycleLength          Int?
  periodDuration       Int?
  pregnancyWeek        Int?
  pregnancyProgress    String?
  healthGoals          String?   @db.Text
  notificationsEnabled Boolean?  @default(true)
  selectedOptions      Json?
  onboardingStep       Int?      @default(1)
  isCompleted          Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime
}

model period_logs {
  id                    Int      @id @default(autoincrement())
  userId                Int
  mood                  String?  @db.Text
  notes                 String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime
  averagePeriodDuration Int?
  lastPeriodDate        DateTime

  @@index([userId], map: "period_logs_userId_fkey")
}

model post_categories {
  id          String   @id
  name        String
  description String   @db.Text
  color       String?
  icon        String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model post_likes {
  id        String   @id
  postId    String
  userId    Int
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId], map: "post_likes_userId_fkey")
}

model post_media {
  id        String          @id
  postId    String
  url       String
  type      post_media_type
  caption   String?         @db.Text
  order     Int             @default(0)
  createdAt DateTime        @default(now())

  @@index([postId], map: "post_media_postId_fkey")
}

model posts {
  id          String   @id
  content     String?  @db.Text
  chatId      String
  authorId    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  isAnonymous Boolean  @default(false)
  categoryId  String?

  @@index([authorId], map: "posts_authorId_fkey")
  @@index([categoryId], map: "posts_categoryId_fkey")
  @@index([chatId], map: "posts_chatId_fkey")
}

model pregnancy_planning {
  id                    Int      @id @default(autoincrement())
  userId                Int
  lastPeriodDate        DateTime
  cycleLength           Int
  lifestyleGoals        String?  @db.Text
  notes                 String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime
  averagePeriodDuration Int

  @@index([userId], map: "pregnancy_planning_userId_fkey")
}

model reproductive_state {
  id        Int                      @id @default(autoincrement())
  userId    Int                      @unique
  state     reproductive_state_state
  updatedAt DateTime
  createdAt DateTime                 @default(now())

  @@index([state], map: "reproductive_state_state_idx")
}

model pregnancy {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  startDate   DateTime
  endDate     DateTime?
  currentWeek Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([userId, endDate], map: "pregnancy_user_end_idx")
}

model cycle_data {
  id                         Int      @id @default(autoincrement())
  userId                     Int      @unique
  lastPeriodDate             DateTime?
  cycleLength                Int?
  /** Running cycle length estimate updated when actual vs predicted period is observed (days). */
  adaptiveCycleLength        Float?
  /** Last up to 5 prediction errors in days: actualPeriodStart − predictedPeriodStart (FIFO). */
  predictionErrors           Json?
  /** Last published next-period date (ISO YYYY-MM-DD) for error tracking. */
  lastPredictedNextPeriodIso String?  @db.VarChar(12)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime
}

model refresh_tokens {
  id        String   @id
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  isRevoked Boolean  @default(false)

  @@index([userId], map: "refresh_tokens_userId_fkey")
}

model secret_chats {
  id          String   @id
  name        String?
  description String?  @db.Text
  isGroup     Boolean  @default(false)
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([createdById], map: "secret_chats_createdById_fkey")
}

model trackday {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      DateTime
  mood      String?  @db.Text
  energy    String?  @db.Text
  symptoms  String?  @db.Text
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@unique([userId, date])
}

/** One row per app-open event (used for 30d engagement opens count). */
model user_app_open {
  id        Int      @id @default(autoincrement())
  userId    Int
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt], map: "user_app_open_userId_createdAt_idx")
}

/** Cached engagement + notification throttling per user. */
model user_engagement {
  userId                            Int       @id
  lastOpenAt                        DateTime?
  /** Preferred local delivery hour 0–23 (client-supplied; digest uses UTC hour as fallback). */
  lastActiveHour                    Int?
  engagementScore                   Float     @default(0)
  engagementTier                    String    @default("LOW") @db.VarChar(8)
  lastNotificationSentAt            DateTime?
  /** UTC calendar day YYYY-MM-DD of last outbound notification (max 1/day). */
  lastNotificationDayIso          String?   @db.VarChar(10)
  consecutiveIgnoredNotifications Int       @default(0)
  /** Organic growth: referral rewards + daily check-in bonuses (not currency). */
  growthPoints                      Int       @default(0)
  /** Consecutive UTC calendar days with at least one check-in. */
  checkInStreak                     Int       @default(0)
  /** UTC YYYY-MM-DD of last successful daily check-in. */
  lastCheckInDayIso                 String?   @db.VarChar(10)
  createdAt                         DateTime  @default(now())
  updatedAt                         DateTime  @updatedAt
  user                              user      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model health_notification_log {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   @db.VarChar(48)
  message   String   @db.Text
  sentAt    DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt], map: "health_notification_log_user_sent_idx")
}

model user {
  id                           Int         @id @default(autoincrement())
  email                        String      @unique
  phoneNumber                  String      @unique
  fullName                     String
  role                         user_role   @default(USER)
  status                       user_status @default(ACTIVE)
  isVerified                   Boolean     @default(false)
  createdAt                    DateTime    @default(now())
  updatedAt                    DateTime
  emailVerificationCode        String?
  emailVerificationCodeExpires DateTime?
  dateOfBirth                  DateTime?
  user_app_open                user_app_open[]
  user_engagement              user_engagement?
  health_notification_log      health_notification_log[]
  user_subscription            user_subscription?
  referral_code                referral_code?
  referrals_sent               referral[]  @relation("ReferralReferrer")
  referral_received            referral?   @relation("ReferralReferred")
}

/** Stable invite code per user (for referral links). */
model referral_code {
  userId    Int      @id
  code      String   @unique @db.VarChar(12)
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/** One row when a new user successfully joins with a referrer's code (rewards both). */
model referral {
  id             Int      @id @default(autoincrement())
  referrerUserId Int
  referredUserId Int      @unique
  code           String   @db.VarChar(12)
  createdAt      DateTime @default(now())
  referrer       user     @relation("ReferralReferrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referred       user     @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerUserId], map: "referral_referrer_user_idx")
}

/** Freemium / trial / subscription state (single row per user). */
model user_subscription {
  userId                   Int                               @id
  tier                     user_subscription_tier           @default(FREE)
  /** First authenticated subscription API touch; drives “days of use” paywall. */
  firstOpenedAt            DateTime?
  trialStartedAt           DateTime?
  trialEndsAt              DateTime?
  /** Active paid access until (mock billing sets this). */
  premiumUntil             DateTime?
  billingInterval          user_subscription_billing_interval?
  /** Random 3–5: suggest usage-based paywall after this many local usage days. */
  usageDayPaywallThreshold Int                               @default(4)
  createdAt                DateTime                          @default(now())
  updatedAt                DateTime                          @updatedAt
  user                     user                              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum user_subscription_tier {
  FREE
  PREMIUM_TRIAL
  PREMIUM
}

enum user_subscription_billing_interval {
  MONTH
  YEAR
}

model user_profile {
  id           Int       @id @default(autoincrement())
  userId       Int       @unique
  bio          String?
  avatarUrl    String?
  dateOfBirth  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  profileImage String?
}

enum chat_members_role {
  ADMIN
  MODERATOR
  MEMBER
}

enum post_media_type {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum chat_messages_messageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum user_role {
  USER
  ADMIN
}

enum user_status {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum doctors_consultationType {
  ONLINE
  IN_PERSON
  BOTH
}

enum reproductive_state_state {
  CYCLE
  PLANNING
  PREGNANT
  POSTPARTUM
}
