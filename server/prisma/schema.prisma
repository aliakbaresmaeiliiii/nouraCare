generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model user {
  id                        Int       @id @default(autoincrement())
  email                     String    @unique(map: "User_email_key")
  phone                     String    @unique(map: "User_phone_key")
  verificationCode          String?
  name          String?
  verificationCodeExpiresAt DateTime?
  isVerified                Boolean   @default(false)
  createdAt                 DateTime  @default(now())
  profileImage              String?
  status                    Status?
  menstrualCycleLength      Int?
  periodDuration            Int?
  lastPeriodStartDate       DateTime?
  birthday                  DateTime?  
  city                      String?
  pregnancyWeek             Int?
  pregnancyProgress         String?
  healthGoals               String?    // JSON string array
  notificationsEnabled      Boolean    @default(true)
  updatedAt                 DateTime   @default(now()) @updatedAt

  // Relations
  addresses                 Address[]
  trackDays                 TrackDay[]
}

enum Status {
  PLANNING_PREGNANCY
  PREGNANT
  HAS_CHILD
}

model City {
  id        Int        @id @default(autoincrement())
  name      String
  state     String?
  districts District[]
  addresses Address[]
}

model District {
  id      Int    @id @default(autoincrement())
  name    String
  cityId  Int
  city    City   @relation(fields: [cityId], references: [id])
  addresses Address[]
}

model Address {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        user     @relation(fields: [userId], references: [id])
  cityId      Int
  city        City     @relation(fields: [cityId], references: [id])
  districtId  Int?
  district    District? @relation(fields: [districtId], references: [id])
  addressLine String
  createdAt   DateTime @default(now())
}

model TrackDay {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      user     @relation(fields: [userId], references: [id])
  date      DateTime
  mood      String?  @db.Text // JSON string for mood data
  energy    String?  @db.Text // JSON string for energy data
  symptoms  String?  @db.Text // JSON string array for symptoms
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, date], map: "userId_date")
}
