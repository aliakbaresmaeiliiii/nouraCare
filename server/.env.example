# Required in production (NODE_ENV=production)
JWT_SECRET=generate-a-long-random-secret
DB_PASSWORD=your-database-password

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dorehealth
DB_NAME=dorehealth

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated allowed origins (production). Dev also allows localhost:4200 + admin:4300.
CORS_ORIGINS=capacitor://localhost,https://localhost,http://localhost:4200,http://localhost:4300,https://dorehealth.ir,https://www.dorehealth.ir,https://app.dorehealth.ir

# Optional: promote these emails to ADMIN on seed (comma-separated)
# ADMIN_EMAILS=you@example.com

# OAuth — verify social tokens server-side (comma-separated if multiple)
GOOGLE_CLIENT_IDS=1088321651982-l914r5o4bj5c73cua6qdcg0ttjnd8hbh.apps.googleusercontent.com
APPLE_CLIENT_IDS=com.tecknnycs.dorehealth,com.tecknnycs.dorehealth.signin

# Public URL for uploaded profile images
BASE_URL=https://api.dorehealth.ir

# Display name in outbound emails
APP_NAME=DoreHealth

# Email (OTP / verification) — configure one provider
# EMAIL_OTP_ENABLED=true
# EMAIL_STRICT=true
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAIL_HOST=
# MAIL_USERNAME=
# MAIL_PASSWORD=

# sms.ir — phone OTP (server only; never put these in the Angular client)
# Get API key from sms.ir panel → Settings. Auth header is X-API-KEY.
SMS_IR_API_KEY=your-sms-ir-api-key
SMS_IR_LINE_NUMBER=50003181890144
# REQUIRED for reliable OTP delivery:
# 1) sms.ir panel → قالب‌های احراز هویت (Verify templates) → create a template with a CODE placeholder
# 2) put the numeric template ID here
SMS_IR_VERIFY_TEMPLATE_ID=0
SMS_IR_VERIFY_PARAM_NAME=OTP
# Fallback bulk text only if VERIFY_TEMPLATE_ID is 0 (operators often block this for OTP)
# SMS_OTP_MESSAGE_TEMPLATE=کد ورود شما: {code}
# Phone OTP expires after 3 minutes (see SMS_OTP_VALIDITY_MS in auth constants)
SMS_OTP_SKIP_EMAIL=true
SMS_STRICT=true
