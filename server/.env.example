# Required in production (NODE_ENV=production)
JWT_SECRET=generate-a-long-random-secret
DB_PASSWORD=your-database-password

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nouracare
DB_NAME=nouracare

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated allowed origins (required in production for mobile/web clients)
CORS_ORIGINS=capacitor://localhost,https://localhost,https://api.nouracare.com

# OAuth — verify social tokens server-side (comma-separated if multiple)
GOOGLE_CLIENT_IDS=1088321651982-l914r5o4bj5c73cua6qdcg0ttjnd8hbh.apps.googleusercontent.com
APPLE_CLIENT_IDS=com.tecknnycs.nouracare,com.tecknnycs.nouracare.signin

# Public URL for uploaded profile images
BASE_URL=https://api.nouracare.com

