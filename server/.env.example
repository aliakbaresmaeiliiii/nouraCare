# Required in production (NODE_ENV=production)
JWT_SECRET=generate-a-long-random-secret
DB_PASSWORD=your-database-password

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_NAME=nouracare

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated allowed origins (required in production for mobile/web clients)
# CORS_ORIGINS=https://app.example.com,capacitor://localhost,http://localhost

# OAuth — verify social tokens server-side
GOOGLE_CLIENT_IDS=your-google-web-client-id.apps.googleusercontent.com
# APPLE_CLIENT_IDS=com.example.app

# Public URL for uploaded files
# BASE_URL=https://api.example.com
