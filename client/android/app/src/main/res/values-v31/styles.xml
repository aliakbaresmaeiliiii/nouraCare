<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: SplashScreen API (attrs from androidx.core:core-splashscreen).
         windowSplashScreenBrandingImage is not reliably available at link time for this stack; omit it. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
