{

  "name": "nouracare-app",

  "type": "module",

  "version": "0.0.1",

  "author": "Ionic Framework",

  "homepage": "https://ionicframework.com/",

  "scripts": {

    "ng": "ng",

    "ionic": "ionic serve",

    "server": "ionic serve",

    "start": "ng serve --proxy-config proxy.conf.json",

    "proxy": "ng serve --proxy-config proxy.conf.json",

    "dev:lan": "ng serve --proxy-config proxy.conf.json --host 0.0.0.0",

    "build": "node --max-old-space-size=8192 ./node_modules/@angular/cli/bin/ng.js build",

    "build:en": "node --max-old-space-size=8192 ./node_modules/@angular/cli/bin/ng.js build --configuration=en",

    "build:zh": "node --max-old-space-size=8192 ./node_modules/@angular/cli/bin/ng.js build --configuration=zh",

    "build:ms": "node --max-old-space-size=8192 ./node_modules/@angular/cli/bin/ng.js build --configuration=ms",

    "serve:en": "ng serve --configuration=en",

    "serve:zh": "ng serve --configuration=zh",

    "serve:ms": "ng serve --configuration=ms",

    "watch": "node --max-old-space-size=8192 ./node_modules/@angular/cli/bin/ng.js build --watch --configuration development",

    "test": "ng test",

    "lint": "ng lint",

    "extract-i18n": "ng extract-i18n",

    "icons:android": "node scripts/generate-android-icons.mjs",

    "android:clean": "node scripts/clean-android-build.mjs",

    "cap:clean-sync": "node scripts/clean-android-build.mjs && npx cap sync android",

    "cap:sync": "npx cap sync android",

    "cap:sync:url": "node scripts/cap-sync-url.mjs",

    "cap:android": "npx cap open android",

    "run:all": "node node_modules/@angular-architects/module-federation/src/server/mf-dev-server.js",

    "android:live": "node scripts/run-android-live.mjs"

  },

  "private": true,

  "dependencies": {

    "@angular/animations": "^21.2.1",

    "@angular/cdk": "^21.2.6",

    "@angular/common": "^21.2.1",

    "@angular/compiler": "^21.2.1",

    "@angular/core": "^21.2.1",

    "@angular/forms": "^21.2.1",

    "@angular/platform-browser": "^21.2.1",

    "@angular/platform-browser-dynamic": "^21.2.1",

    "@angular/router": "^21.2.1",

    "@capacitor/android": "^8.2.0",

    "@capacitor/app": "^8.0.1",

    "@capacitor/core": "^8.2.0",

    "@capacitor/haptics": "^8.0.1",

    "@capacitor/keyboard": "^8.0.1",

    "@capacitor/share": "^8.0.1",

    "@capacitor/status-bar": "^8.0.1",

    "@capgo/capacitor-social-login": "^8.3.13",

    "@ionic/angular": "^8.8.1",

    "@tailwindcss/postcss": "^4.2.1",


    "angular-auth-oidc-client": "^21.0.1",

    "date-fns-jalali": "^4.1.0-0",

    "ionicons": "^8.0.13",


    "ngx-image-cropper": "^9.1.5",

    "postcss": "^8.5.8",

    "rxjs": "^7.8.2",

    "socket.io-client": "^4.8.1",

    "swiper": "^12.1.2",

    "tailwindcss": "^4.1.12",

    "three": "^0.180.0",

    "tslib": "^2.8.1",

    "zone.js": "~0.16.1"

  },

  "devDependencies": {

    "@angular-architects/module-federation": "^21.2.1",

    "@angular-devkit/build-angular": "^21.2.1",

    "@angular-eslint/builder": "^21.2.1",

    "@angular-eslint/eslint-plugin": "^21.2.1",

    "@angular-eslint/eslint-plugin-template": "^21.2.1",

    "@angular-eslint/schematics": "^21.2.1",

    "@angular-eslint/template-parser": "^21.2.1",

    "@angular/cli": "^21.2.10",

    "@angular/compiler-cli": "^21.2.1",

    "@angular/language-service": "^21.2.1",

    "@capacitor/cli": "^8.2.0",

    "@ionic/angular-toolkit": "^12.3.0",

    "@ionic/cli": "^7.2.1",

    "@types/jasmine": "~6.0.0",

    "@types/three": "^0.183.1",

    "@typescript-eslint/eslint-plugin": "^8.57.0",

    "@typescript-eslint/parser": "^8.57.0",

    "eslint": "^10.0.3",

    "eslint-plugin-import": "^2.32.0",

    "eslint-plugin-jsdoc": "^62.7.1",

    "eslint-plugin-prefer-arrow": "^1.2.3",

    "jasmine-core": "~6.1.0",

    "jasmine-spec-reporter": "~7.0.0",

    "karma": "~6.4.4",

    "karma-chrome-launcher": "~3.2.0",

    "karma-coverage": "~2.2.1",

    "karma-jasmine": "~5.1.0",

    "karma-jasmine-html-reporter": "~2.1.0",

    "ngx-build-plus": "^20.0.0",

    "sharp": "^0.34.5",

    "typescript": "~5.9.3"

  },

  "description": "NouraCare is a family-friendly app built with Ionic and Angular.",

  "keywords": [

    "ionic",

    "angular",

    "nouracare",

    "islamic",

    "family"

  ]

}

