# Copy to deploy/.env — used by docker compose only
JWT_SECRET=change-me-use-openssl-rand-hex-32
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-root-password
DB_NAME=dorehealth
DB_USER=dorehealth
GOOGLE_CLIENT_IDS=1088321651982-l914r5o4bj5c73cua6qdcg0ttjnd8hbh.apps.googleusercontent.com
APPLE_CLIENT_IDS=com.tecknnycs.dorehealth,com.tecknnycs.dorehealth.signin
CORS_ORIGINS=capacitor://localhost,https://localhost,https://dorehealth.ir,https://www.dorehealth.ir,https://app.dorehealth.ir
BASE_URL=https://api.dorehealth.ir

# sms.ir — required for phone OTP (without these, only email login works)
# Panel → Settings for API key; verify-template ID from قالب‌های احراز هویت
SMS_IR_API_KEY=your-sms-ir-api-key
SMS_IR_LINE_NUMBER=3000xxxxxxx
SMS_IR_VERIFY_TEMPLATE_ID=0
# Must match the placeholder name in your sms.ir verify template (e.g. OTP or Code)
SMS_IR_VERIFY_PARAM_NAME=OTP
SMS_OTP_SKIP_EMAIL=true
SMS_STRICT=true
